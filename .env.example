# Public site URL (used for canonical URLs, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.drcokenyaririadvocatesllp.africa

# ── Microsoft 365 email via Microsoft Graph (see README) ─────────────────────
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Mailbox the website sends FROM (a licensed user or shared mailbox)
MS_SENDER_MAILBOX=website@drcokenyaririadvocatesllp.africa

# Where new enquiries are delivered (defaults to MS_SENDER_MAILBOX)
INQUIRY_INBOX=kenyariri@drcokenyaririadvocatesllp.africa
# Optional per-practice routing: slug:email pairs, comma-separated
INQUIRY_ROUTES=family-succession:family@drcokenyaririadvocatesllp.africa,corporate-commercial:corporate@drcokenyaririadvocatesllp.africa
# Where newsletter sign-ups are reported (defaults to INQUIRY_INBOX)
NEWSLETTER_INBOX=

# Optional: Microsoft Bookings page link (shows "Book online" on /contact and in the client email)
NEXT_PUBLIC_BOOKINGS_URL=

# Optional: search console verification codes
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
